# Copy to `.env` and fill in. `.env` is git-ignored.

# --- GitHub OAuth ---
# Create a GitHub OAuth App (Settings -> Developer settings -> OAuth Apps -> New):
#   Homepage URL:               https://<GARMIN_MCP_DOMAIN>
#   Authorization callback URL: https://<GARMIN_MCP_DOMAIN>/auth/callback
# Then copy the credentials here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only this GitHub login may use the connector (your username). Everyone else
# is denied even after a successful GitHub login.
ALLOWED_GITHUB_USER=Wampa04

# Domain that Traefik routes to this service. The MCP endpoint will be
# https://<this-domain>/mcp and OAuth callbacks hit https://<this-domain>/auth/callback
GARMIN_MCP_DOMAIN=garmin-mcp.deinedomain.de

# Optional: stable signing key so tokens issued to Claude survive container
# restarts (without it, a restart forces a re-login). Generate: openssl rand -hex 32
MCP_JWT_SECRET=

# Path inside the container where the garth tokens are mounted.
# Leave as-is unless you change the volume mount in docker-compose.yml.
GARMINTOKENS=/tokens
